include(FetchContent)
set(FETCHCONTENT_QUIET OFF)
set(SDL_TESTS OFF CACHE BOOL "" FORCE)
set(SDL_EXAMPLES OFF CACHE BOOL "" FORCE)
set(SDL_SHARED OFF CACHE BOOL "" FORCE)
set(SDL_STATIC ON CACHE BOOL "" FORCE)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(INTERPROCEDURAL_OPTIMIZATION OFF CACHE BOOL "" FORCE)
set(GENERATE_DEBUG_SYMBOLS OFF CACHE BOOL "" FORCE)
set(OVERRIDE_CXX_FLAGS OFF CACHE BOOL "" FORCE)
set(USE_STATIC_MSVC_RUNTIME_LIBRARY OFF CACHE BOOL "" FORCE)
set(TARGET_UNIT_TESTS OFF CACHE BOOL "" FORCE)
set(TARGET_HELLO_WORLD OFF CACHE BOOL "" FORCE)
set(TARGET_PERFORMANCE_TEST OFF CACHE BOOL "" FORCE)
set(TARGET_SAMPLES OFF CACHE BOOL "" FORCE)
set(TARGET_VIEWER OFF CACHE BOOL "" FORCE)
set(ENABLE_ALL_WARNINGS OFF CACHE BOOL "" FORCE)
FetchContent_Declare(jolt GIT_REPOSITORY https://github.com/jrouwe/JoltPhysics.git GIT_TAG 0373ec0dd762e4bc2f6acdb08371ee84fa23c6db SOURCE_SUBDIR Build)
FetchContent_Declare(enet GIT_REPOSITORY https://github.com/lsalzman/enet.git GIT_TAG v1.3.18 GIT_SHALLOW TRUE)
FetchContent_Declare(lua GIT_REPOSITORY https://github.com/lua/lua.git GIT_TAG v5.4.8 GIT_SHALLOW TRUE)
FetchContent_MakeAvailable(jolt enet lua)
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/licenses")
file(COPY "${jolt_SOURCE_DIR}/LICENSE" DESTINATION "${CMAKE_BINARY_DIR}/licenses/Jolt")
file(COPY "${enet_SOURCE_DIR}/LICENSE" DESTINATION "${CMAKE_BINARY_DIR}/licenses/ENet")
file(COPY "${lua_SOURCE_DIR}/lua.h" DESTINATION "${CMAKE_BINARY_DIR}/licenses/Lua")
file(GLOB LUA_SOURCES CONFIGURE_DEPENDS "${lua_SOURCE_DIR}/*.c")
list(FILTER LUA_SOURCES EXCLUDE REGEX "/(lua|onelua|ltests)\\.c$")
add_library(aspera_lua STATIC ${LUA_SOURCES})
target_include_directories(aspera_lua PUBLIC "${lua_SOURCE_DIR}")
if(UNIX)
  target_compile_definitions(aspera_lua PRIVATE LUA_USE_POSIX)
  target_link_libraries(aspera_lua PUBLIC ${CMAKE_DL_LIBS} m)
endif()
target_include_directories(enet PUBLIC "${enet_SOURCE_DIR}/include")
if(WIN32)
  target_link_libraries(enet PUBLIC winmm ws2_32)
endif()
if(ASPERA_DESKTOP)
  FetchContent_Declare(sdl GIT_REPOSITORY https://github.com/libsdl-org/SDL.git GIT_TAG release-3.2.10 GIT_SHALLOW TRUE)
  FetchContent_Declare(imgui GIT_REPOSITORY https://github.com/ocornut/imgui.git GIT_TAG v1.91.9b GIT_SHALLOW TRUE)
  set(BGFX_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
  set(BGFX_BUILD_TOOLS ON CACHE BOOL "" FORCE)
  set(BGFX_BUILD_TOOLS_GEOMETRY OFF CACHE BOOL "" FORCE)
  set(BGFX_BUILD_TOOLS_TEXTURE OFF CACHE BOOL "" FORCE)
  set(BGFX_BUILD_TOOLS_BIN2C OFF CACHE BOOL "" FORCE)
  set(BGFX_INSTALL OFF CACHE BOOL "" FORCE)
  FetchContent_Declare(bgfx_cmake GIT_REPOSITORY https://github.com/bkaradzic/bgfx.cmake.git GIT_TAG 7cea9ab17c6dc8745cdc5df992145c514a129abb)
  FetchContent_MakeAvailable(sdl imgui bgfx_cmake)
  if(APPLE)
    include("${CMAKE_CURRENT_LIST_DIR}/MetalComputeProfiling.cmake")
  endif()
  file(COPY "${sdl_SOURCE_DIR}/LICENSE.txt" DESTINATION "${CMAKE_BINARY_DIR}/licenses/SDL3")
  file(COPY "${imgui_SOURCE_DIR}/LICENSE.txt" DESTINATION "${CMAKE_BINARY_DIR}/licenses/ImGui")
  file(GLOB_RECURSE BGFX_NOTICES "${bgfx_cmake_SOURCE_DIR}/*LICENSE*" "${bgfx_cmake_SOURCE_DIR}/*COPYING*")
  foreach(NOTICE IN LISTS BGFX_NOTICES)
    file(RELATIVE_PATH NOTICE_REL "${bgfx_cmake_SOURCE_DIR}" "${NOTICE}")
    get_filename_component(NOTICE_DIR "${NOTICE_REL}" DIRECTORY)
    file(COPY "${NOTICE}" DESTINATION "${CMAKE_BINARY_DIR}/licenses/bgfx/${NOTICE_DIR}")
  endforeach()
  add_library(aspera_imgui STATIC "${imgui_SOURCE_DIR}/imgui.cpp" "${imgui_SOURCE_DIR}/imgui_draw.cpp" "${imgui_SOURCE_DIR}/imgui_tables.cpp" "${imgui_SOURCE_DIR}/imgui_widgets.cpp" "${imgui_SOURCE_DIR}/backends/imgui_impl_sdl3.cpp")
  target_include_directories(aspera_imgui PUBLIC "${imgui_SOURCE_DIR}" "${imgui_SOURCE_DIR}/backends")
  target_link_libraries(aspera_imgui PUBLIC SDL3::SDL3)
endif()
