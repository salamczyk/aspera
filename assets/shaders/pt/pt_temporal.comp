#version 460
#extension GL_GOOGLE_include_directive : enable

#include "pt_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(std140, set = 0, binding = 0) uniform PtParamsBlock { PtParams params; };

layout(set = 0, binding = 8, rgba32f) uniform readonly image2D rawDiffuse;
layout(set = 0, binding = 9, rgba32f) uniform readonly image2D rawSpecular;
layout(set = 0, binding = 10, rgba32f) uniform readonly image2D guideImage;
layout(set = 0, binding = 11, rgba32f) uniform readonly image2D albedoImage;
layout(set = 0, binding = 12, rgba32f) uniform readonly image2D motionImage;
layout(set = 0, binding = 13, rgba32f) uniform image2D historyDiffuse;
layout(set = 0, binding = 14, rgba32f) uniform image2D historySpecular;
layout(set = 0, binding = 15, rgba32f) uniform image2D historyGuide;
layout(set = 0, binding = 16, rgba32f) uniform image2D historyMotion;
layout(set = 0, binding = 17, rgba32f) uniform image2D moments;
layout(set = 0, binding = 18, rgba32f) uniform readonly image2D previousMoments;
layout(set = 0, binding = 24, rgba32f) uniform readonly image2D previousGuide;
layout(set = 0, binding = 25, rgba32f) uniform readonly image2D previousMotion;
layout(set = 0, binding = 26, rgba32f) uniform readonly image2D previousDiffuse;
layout(set = 0, binding = 27, rgba32f) uniform readonly image2D previousSpecular;

ivec2 ptClampPixel(ivec2 p, ivec2 size) {
    return clamp(p, ivec2(0), size - ivec2(1));
}

void ptSampleCoords(vec2 uv, ivec2 size, out ivec2 p00, out ivec2 p10,
                    out ivec2 p01, out ivec2 p11, out vec2 f) {
    vec2 pixel = clamp(uv, vec2(0.0), vec2(1.0)) * vec2(size) - vec2(0.5);
    ivec2 p0 = ivec2(floor(pixel));
    f = fract(pixel);
    p00 = ptClampPixel(p0, size);
    p10 = ptClampPixel(p0 + ivec2(1, 0), size);
    p01 = ptClampPixel(p0 + ivec2(0, 1), size);
    p11 = ptClampPixel(p0 + ivec2(1, 1), size);
}

vec4 ptSamplePreviousGuide(vec2 uv, ivec2 size) {
    ivec2 p00, p10, p01, p11; vec2 f;
    ptSampleCoords(uv, size, p00, p10, p01, p11, f);
    return mix(mix(imageLoad(previousGuide, p00), imageLoad(previousGuide, p10), f.x),
               mix(imageLoad(previousGuide, p01), imageLoad(previousGuide, p11), f.x), f.y);
}

vec4 ptSamplePreviousMotion(vec2 uv, ivec2 size) {
    ivec2 p00, p10, p01, p11; vec2 f;
    ptSampleCoords(uv, size, p00, p10, p01, p11, f);
    return mix(mix(imageLoad(previousMotion, p00), imageLoad(previousMotion, p10), f.x),
               mix(imageLoad(previousMotion, p01), imageLoad(previousMotion, p11), f.x), f.y);
}

vec4 ptSamplePreviousDiffuse(vec2 uv, ivec2 size) {
    ivec2 p00, p10, p01, p11; vec2 f;
    ptSampleCoords(uv, size, p00, p10, p01, p11, f);
    return mix(mix(imageLoad(previousDiffuse, p00), imageLoad(previousDiffuse, p10), f.x),
               mix(imageLoad(previousDiffuse, p01), imageLoad(previousDiffuse, p11), f.x), f.y);
}

vec4 ptSamplePreviousSpecular(vec2 uv, ivec2 size) {
    ivec2 p00, p10, p01, p11; vec2 f;
    ptSampleCoords(uv, size, p00, p10, p01, p11, f);
    return mix(mix(imageLoad(previousSpecular, p00), imageLoad(previousSpecular, p10), f.x),
               mix(imageLoad(previousSpecular, p01), imageLoad(previousSpecular, p11), f.x), f.y);
}

vec4 ptSamplePreviousMoments(vec2 uv, ivec2 size) {
    ivec2 p00, p10, p01, p11; vec2 f;
    ptSampleCoords(uv, size, p00, p10, p01, p11, f);
    return mix(mix(imageLoad(previousMoments, p00), imageLoad(previousMoments, p10), f.x),
               mix(imageLoad(previousMoments, p01), imageLoad(previousMoments, p11), f.x), f.y);
}

void ptRawNeighborhood(ivec2 center, ivec2 size, out vec3 minDiffuse,
                       out vec3 maxDiffuse, out vec3 minSpecular, out vec3 maxSpecular) {
    minDiffuse = minSpecular = vec3(1.0e30);
    maxDiffuse = maxSpecular = vec3(-1.0e30);
    for (int y = -1; y <= 1; ++y) for (int x = -1; x <= 1; ++x) {
        ivec2 q = ptClampPixel(center + ivec2(x, y), size);
        vec3 d = imageLoad(rawDiffuse, q).rgb;
        vec3 s = imageLoad(rawSpecular, q).rgb;
        minDiffuse = min(minDiffuse, d); maxDiffuse = max(maxDiffuse, d);
        minSpecular = min(minSpecular, s); maxSpecular = max(maxSpecular, s);
    }
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    uvec2 sizeU = params.sizeFrame.xy;
    if (pixel.x >= sizeU.x || pixel.y >= sizeU.y) return;
    ivec2 ip = ivec2(pixel);
    ivec2 size = ivec2(sizeU);
    vec4 currentDiffuse = imageLoad(rawDiffuse, ip);
    vec4 currentSpecular = imageLoad(rawSpecular, ip);
    vec4 currentGuide = imageLoad(guideImage, ip);
    vec4 currentMotion = imageLoad(motionImage, ip);
    bool reset = params.sizeFrame.w != 0u;
    bool currentSurface = dot(currentGuide.xyz, currentGuide.xyz) > 0.01;
    vec2 previousUv = currentMotion.xy;
    bool validUv = all(greaterThanEqual(previousUv, vec2(0.0))) &&
                   all(lessThanEqual(previousUv, vec2(1.0)));
    vec4 oldDiffuse = vec4(0.0), oldSpecular = vec4(0.0);
    vec4 oldGuide = vec4(0.0), oldMotion = vec4(0.0), oldMoment = vec4(0.0);
    float historyWeight = 0.0;
    bool stationaryReuse = !reset && params.options.y != 0u;
    if (stationaryReuse) {
        // A stationary reference capture must accumulate the same output
        // pixel even when jitter moves its ray across a silhouette.  Reusing
        // the projected guide would reject exactly those unbiased samples.
        oldDiffuse = imageLoad(previousDiffuse, ip);
        oldSpecular = imageLoad(previousSpecular, ip);
        oldGuide = imageLoad(previousGuide, ip);
        oldMotion = imageLoad(previousMotion, ip);
        oldMoment = imageLoad(previousMoments, ip);
        historyWeight = max(float(params.options.z), 0.0);
    } else if (!reset && validUv) {
        oldDiffuse = ptSamplePreviousDiffuse(previousUv, size);
        oldSpecular = ptSamplePreviousSpecular(previousUv, size);
        oldGuide = ptSamplePreviousGuide(previousUv, size);
        oldMotion = ptSamplePreviousMotion(previousUv, size);
        oldMoment = ptSamplePreviousMoments(previousUv, size);
        bool oldSurface = dot(oldGuide.xyz, oldGuide.xyz) > 0.01;
        vec4 reprojectedGuide = oldGuide;
        vec4 reprojectedMotion = oldMotion;
        bool skyCompatible = !currentSurface && !oldSurface;
        bool guideCompatible = skyCompatible ||
            (dot(normalize(currentGuide.xyz), normalize(reprojectedGuide.xyz)) > 0.90 &&
             abs(currentGuide.w - reprojectedGuide.w) <= max(0.05, currentGuide.w * 0.04));
        bool identityCompatible = !currentSurface ||
            (abs(currentMotion.z - reprojectedMotion.z) < 0.5 &&
             abs(currentMotion.w - reprojectedMotion.w) < 0.5);
        if (guideCompatible && identityCompatible) {
            float frameSampleCount = max(float(params.counts.x), 1.0);
            historyWeight = min(max(oldMoment.z, 0.0), 7.0 * frameSampleCount);
            if (historyWeight > 0.0) {
                vec3 minDiffuse, maxDiffuse, minSpecular, maxSpecular;
                ptRawNeighborhood(ip, size, minDiffuse, maxDiffuse, minSpecular, maxSpecular);
                float variance = max(oldMoment.g - oldMoment.r * oldMoment.r, 0.0);
                float expand = 1.5 * sqrt(variance) + 0.01;
                oldDiffuse.rgb = clamp(oldDiffuse.rgb, minDiffuse - expand, maxDiffuse + expand);
                oldSpecular.rgb = clamp(oldSpecular.rgb, minSpecular - expand, maxSpecular + expand);
            }
        }
    }
    historyWeight = max(historyWeight, 0.0);
    float sampleCount = max(float(params.counts.x), 1.0);
    float totalWeight = historyWeight + sampleCount;
    vec3 resolvedDiffuse = (historyWeight > 0.0 ? oldDiffuse.rgb * historyWeight : vec3(0.0)) +
                           currentDiffuse.rgb * sampleCount;
    vec3 resolvedSpecular = (historyWeight > 0.0 ? oldSpecular.rgb * historyWeight : vec3(0.0)) +
                            currentSpecular.rgb * sampleCount;
    resolvedDiffuse /= max(totalWeight, 1.0e-5);
    resolvedSpecular /= max(totalWeight, 1.0e-5);
    vec4 resolvedGuide = currentGuide;
    vec4 resolvedMotion = currentMotion;
    if (!stationaryReuse && historyWeight > 0.0 && !currentSurface && dot(oldGuide.xyz, oldGuide.xyz) > 0.01) {
        resolvedGuide = oldGuide;
        resolvedMotion = oldMotion;
    }
    float luminance = ptLuminance(currentDiffuse.rgb + currentSpecular.rgb);
    float second = luminance * luminance;
    vec2 resolvedMoments = historyWeight > 0.0
        ? (oldMoment.rg * historyWeight + vec2(luminance, second) * sampleCount) / max(totalWeight, 1.0e-5)
        : vec2(luminance, second);
    if (reset) resolvedMoments = vec2(luminance, second);
    imageStore(historyDiffuse, ip, vec4(resolvedDiffuse, 1.0));
    imageStore(historySpecular, ip, vec4(resolvedSpecular, 1.0));
    imageStore(historyGuide, ip, resolvedGuide);
    imageStore(historyMotion, ip, resolvedMotion);
    imageStore(moments, ip, vec4(resolvedMoments, min(totalWeight, 65535.0), 1.0));
}
